include LICENSE
include README.md
include MANIFEST.in
include pyproject.toml
include requirements.txt
include requirements-dev.txt

recursive-include src/petrophys *.py
recursive-include src/petrophys py.typed
recursive-include src/petrophys *.joblib
recursive-include src/petrophys *.xml
recursive-include src/petrophys/data/legacy_context *.json.gz
recursive-include src/petrophys/datasets *.las *.csv *.md

recursive-include docs *.rst *.py Makefile make.bat
recursive-include tests *.py

prune docs/_build
prune **/__pycache__

global-exclude *.pyc
global-exclude *.pyo
global-exclude .DS_Store
