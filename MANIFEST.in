include LICENSE
include THIRD_PARTY_DATA.md
include ACKNOWLEDGEMENTS.md
include CITATION.cff
include CHANGELOG.md
include README.md
include CONTRIBUTING.md
include MANIFEST.in
include pyproject.toml

recursive-include src/petrophys *.py
recursive-include src/petrophys py.typed
recursive-include src/petrophys *.xml
recursive-include src/petrophys/_internal/data *.csv
recursive-include src/petrophys/datasets *.las *.csv *.md *.txt
recursive-include src/petrophys/datasets/phillips *.xlsx *.json
recursive-include src/petrophys/datasets/epslog *.json
recursive-include src/petrophys/datasets/formation_pressure *.DLIS
exclude src/petrophys/datasets/daydream/daydream1_deep_curated_scalar_logs.las
exclude src/petrophys/datasets/daydream/daydream1_shallow_aps_pex_hngs.las

prune docs
prune examples
prune scripts
prune tests
prune .github
prune **/__pycache__

global-exclude *.pyc
global-exclude *.pyo
global-exclude .DS_Store
