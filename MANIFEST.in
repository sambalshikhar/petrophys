include LICENSE
include README.md
include MANIFEST.in
include pyproject.toml
include requirements.txt
include requirements-dev.txt

recursive-include petrophys *.py
recursive-include petrophys py.typed
recursive-include petrophys *.joblib
recursive-include petrophys *.xml
recursive-include petrophys/data *.las *.csv *.md

recursive-include docs *.rst *.py Makefile make.bat
recursive-include tests *.py

prune docs/_build
prune **/__pycache__

global-exclude *.pyc
global-exclude *.pyo
global-exclude .DS_Store
