include LICENSE
include README.md
include CONTRIBUTING.md
include MANIFEST.in
include pyproject.toml

recursive-include src/petrophys *.py
recursive-include src/petrophys py.typed
recursive-include src/petrophys *.joblib
recursive-include src/petrophys *.xml
recursive-include src/petrophys/_internal/data *.json.gz
recursive-include src/petrophys/datasets *.las *.csv *.md *.txt
exclude src/petrophys/datasets/daydream/daydream1_deep_curated_scalar_logs.las
exclude src/petrophys/datasets/daydream/daydream1_shallow_aps_pex_hngs.las

recursive-include docs *.rst *.py Makefile make.bat
recursive-include tests *.py

prune docs/_build
prune **/__pycache__

global-exclude *.pyc
global-exclude *.pyo
global-exclude .DS_Store
